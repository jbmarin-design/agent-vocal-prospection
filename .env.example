# Copier en .env puis compléter. Ne JAMAIS committer le fichier .env.

# --- LiveKit (auto-hébergé, voir deploy/) ---------------------------------------
# Générer : openssl rand -hex 16 (clé) / openssl rand -hex 32 (secret)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=remplacer_par_un_secret_de_64_caracteres_hexadecimaux_minimum_32
AGENT_NAME=avp-prospection
# IP publique (ou LAN) de cette VM, vue par le XiVO (utilisée par livekit-server et livekit-sip)
NODE_IP=203.0.113.10

# --- Infrastructure (optionnel, valeurs par défaut entre crochets — voir docs/installation.md §1.2) ---
# LOCAL_IP=                     [auto] IP locale à utiliser si la VM a plusieurs interfaces
# XIVO_EXTRA_IPS=               autres IP sources du XiVO autorisées par le pare-feu (séparées par des virgules)
# SIP_PORT=5060
# SIP_RTP_PORT_START=10000
# SIP_RTP_PORT_END=20000
# SIP_HEALTH_PORT=8090
# LIVEKIT_RTC_PORT_START=50000
# LIVEKIT_RTC_PORT_END=60000
# LIVEKIT_ALLOWED_CIDRS=        accès externe à LiveKit (dépannage uniquement)
# ADMIN_CIDRS=0.0.0.0/0         origine autorisée pour SSH (mettre votre IP fixe)
# SSH_PORT=22
# LIVEKIT_LOG_LEVEL=info        mettre debug pour diagnostiquer
# SIP_LOG_LEVEL=info

# --- Trunk SIP sortant LiveKit → XiVO -------------------------------------------
XIVO_SIP_ADDRESS=10.0.0.10
XIVO_SIP_TRANSPORT=udp
# Numéro présenté au prospect (E.164) — le XiVO peut aussi le forcer
SIP_CALLER_NUMBER=+33587140500
# Laisser vide si le XiVO authentifie le trunk par IP (recommandé)
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
# Rempli après `avp trunk create` (ID de la forme ST_xxxxxxxx)
SIP_OUTBOUND_TRUNK_ID=

# Transfert à chaud vers un humain (poste sur le XiVO, ex. sip:1001@10.0.0.10).
# Vide = transfert désactivé : l'agent ne le propose jamais et prend un RDV ou un rappel.
TRANSFER_TARGET=

# --- IA ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
LLM_REALTIME_MODEL=claude-haiku-4-5-20251001
LLM_ANALYSIS_MODEL=claude-sonnet-5-5

# Transcription : deepgram (défaut, nova-3) ou cartesia (ink-whisper, même compte que la voix)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=fr

# cartesia | elevenlabs
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
# Choisir une voix française sur play.cartesia.ai et coller son ID
CARTESIA_VOICE_ID=
# Débit de la voix (0.6 à 2.0 ; vide = 1.0 normal). Au téléphone, 0.9 à 1.0 reste confortable ; au-delà de 1.05 c'est vite trop rapide
TTS_SPEED=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=

# --- Axonaut --------------------------------------------------------------------------
# Axonaut > Paramètres > API
AXONAUT_API_KEY=
AXONAUT_BASE_URL=https://axonaut.com/api/v2
AXONAUT_USER_EMAIL=jbmarin@opteolink.fr

# --- Google Agenda + Gmail (docs/google-agenda.md) -----------------------------------
# Client OAuth « Application de bureau » du projet Google Cloud ; puis `avp google auth`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_PORT=8765
# Destinataire des demandes de confirmation de RDV (défaut : AXONAUT_USER_EMAIL)
RDV_CONFIRM_EMAIL=

# --- Garde-fous ---------------------------------------------------------------------------
TIMEZONE=Europe/Paris
MAX_CALL_DURATION_S=360
RING_TIMEOUT_S=40
SILENCE_TIMEOUT_S=20
MAX_CONCURRENT_CALLS=2
# Décroché silencieux : « Allô ? » après AMD_SILENCE_S secondes, puis relance ; raccroche sans réponse
AMD_SILENCE_S=2.5
PRESENCE_WAIT_S=4
# Réactivité : délai entre la fin de votre phrase et la réponse de l'agent.
# Plus bas = plus vif, mais risque de couper la parole sur une hésitation. 0.3 / 2.0 par défaut.
ENDPOINTING_MIN_DELAY=0.3
ENDPOINTING_MAX_DELAY=2.0
# true = aucun appel réel ni écriture Axonaut (simulation)
DRY_RUN=false
